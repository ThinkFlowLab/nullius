{
  "schema": "nullius.agent/v1",
  "key": "codex",
  "label": "Codex",
  "summary": "OpenAI's coding agent.",
  "upstream": {
    "license": "Apache-2.0"
  },
  "start": {
    "acp": [
      "{install}/node_modules/.bin/codex-acp"
    ]
  },
  "model": {
    "apis": [
      "responses"
    ],
    "env": {
      "CODEX_HOME": "{home}/.codex",
      "NULLIUS_RELAY_KEY": "{key}"
    },
    "files": {
      "{home}/.codex/config.toml": "config.toml"
    }
  },
  "caches": [
    "{home}/.codex/.tmp"
  ],
  "options": {
    "reasoning_effort": {
      "summary": "How much reasoning the model uses before answering.",
      "values": [
        "minimal",
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    }
  },
  "default": "2.2.2",
  "versions": {
    "2.2.2": {
      "upstream": {
        "package": "@agentclientprotocol/codex-acp",
        "core": "@openai/codex 0.160.1, a dependency of the adapter (^0.160.1), pinned in install"
      },
      "install": {
        "npm": [
          "@agentclientprotocol/codex-acp@2.2.2",
          "@openai/codex@0.160.1"
        ]
      },
      "env": {
        "INITIAL_AGENT_MODE": "agent-full-access"
      },
      "fidelity": {
        "command": [
          "{install}/node_modules/.bin/codex",
          "exec",
          "--skip-git-repo-check",
          "--json",
          "--",
          "{prompt}"
        ]
      },
      "proven": {
