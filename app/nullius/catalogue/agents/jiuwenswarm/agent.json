        "package": "workswarm",
        "license": "Apache-2.0",
        "core": "openjiuwen 0.1.21 and openjiuwen-agent-gateway 0.1.0, pinned by upstream"
      },
      "install": {
        "python": "3.12",
        "wheels": [
