{
  "schema": "nullius.agent/v1",
  "key": "jiuwenswarm",
  "label": "JiuwenSwarm",
  "summary": "openJiuwen's agent.",
  "upstream": {
    "repository": "https://github.com/openJiuwen-ai/jiuwenswarm",
    "tested": "2aa7fea7e55fbe1edaae0d468ef666b088c76fa9",
    "tested_date": "2026-10-10",
    "package": "workswarm",
    "version": "0.2.7",
    "license": "Apache-2.0"
  },
  "install": {
    "python": "3.12",
    "pip": [
      "workswarm==0.2.7"
    ]
  },
  "start": {
    "acp": [
      "{install}/.venv/bin/python",
      "{here}/agent.py"
    ]
  },
  "model": {
    "apis": [
      "chat"
    ],
    "env": {
      "NULLIUS_BASE_URL": "{base_url}",
      "NULLIUS_KEY": "{key}",
      "NULLIUS_MODEL": "{model}",
      "NULLIUS_REASONING": "{opt_reasoning_effort}"
    }
  },
  "options": {
    "reasoning_effort": {
      "summary": "How much reasoning the model uses before answering, with `default` leaving the choice to the provider.",
      "values": [
        "default",
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "default": "default"
    }
  },
  "offers": [
    "agent.task/v1",
    "agent.workspace/v1",
    "agent.tools/v1",
    "agent.conversation/v1"
  ],
  "proven": {
    "agent.task/v1": {
      "passed": "3/3",
