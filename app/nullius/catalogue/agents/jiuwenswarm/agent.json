      "options": {
        "web_max_fetches": {
          "label": "Page fetch limit",
          "summary": "Pages fetched per invocation; openJiuwen defaults WEB_RESEARCH_MAX_FETCHES to 3.",
          "pattern": "(?:[1-9]|[1-9][0-9]|100)",
          "example": "6",
          "default": "3"
        }
      },
      "model": {
        "apis": [
          "chat"
        ],
        "env": {
          "NULLIUS_BASE_URL": "{base_url}",
          "NULLIUS_KEY": "{key}",
          "NULLIUS_MODEL": "{model}",
          "NULLIUS_REASONING": "{opt_reasoning_effort}",
          "WEB_RESEARCH_MAX_FETCHES": "{opt_web_max_fetches}"
        }
      },
      "fidelity": {
        "command": [
          "{install}/.venv/bin/python",
          "{here}/agent.py",
          "--cli",
          "{prompt}"
        ]
      }
