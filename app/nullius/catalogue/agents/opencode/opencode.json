{
  "$schema": "https://opencode.ai/config.json",
  "model": "nullius/{model}",
  "small_model": "nullius/{model}",
  "enabled_providers": ["nullius"],
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "external_directory": "deny"
  },
  "provider": {
    "nullius": {
      "name": "Nullius relay",
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "{base_url}",
        "apiKey": "{env:NULLIUS_RELAY_KEY}"
      },
      "models": {
        "{model}": {
          "name": "{model}",
          "options": {
            "reasoningEffort": "{opt_reasoning_effort}"
          }
        }
      }
    }
  }
}
