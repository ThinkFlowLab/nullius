      "units": 3722
    }
  ],
  "units": {
    "noun": "question",
    "nouns": "questions"
  },
  "score": {
    "kind": "pass",
    "says": "GSMA's own task for the question, run in Inspect AI's eval loop with the answer as the model's reply: the multiple-choice solver reads the 'ANSWER: <letter>' line and choice() checks the letter (TeleQnA, TeleTables, ORANBench, srsRANBench, 6G-Bench); TeleMath's scorer takes the last \\boxed{} and accepts a number within 1% or 0.01; TeleLogs' takes the last \\boxed{} and compares its first number (soft, the default) or all of it (hard); 3GPP TSG's pattern takes the first working-group code, case aside"
  },
  "controls": {
    "nop": {
      "source": "nullius",
      "from": "Nullius: no agent runs; the answer is empty."
    },
    "oracle": {
      "source": "nullius",
      "from": "Nullius, from the authors' answers: the dataset's answer, written as the task's prompt asks for it ('ANSWER: <letter>', \\boxed{<answer>}, {\"WORKING GROUP\": \"<group>\"}). 3GPP TSG's pattern cannot read RAN_AH1, so those questions fail: 6 of 100 Lite, 129 of 2,000 Full.",
      "expect": {
        "at_least": 0.93
      }
    }
  },
  "setups": {
    "original": {
      "summary": "GSMA's own Inspect task on the question, as `inspect eval` runs it: its prompt (the multiple-choice template, TeleMath's system prompt), one call to the run's model through Inspect's OpenAI-compatible client, and its scorer. Any model, as GSMA's leaderboard ranks them.",
      "providers": {
        "openai": "",
        "openrouter": "",
        "custom": ""
      },
      "turn_seconds": 900,
      "paper": "GSMA's Open Telco leaderboard (GSMA/leaderboard): each model's accuracy per test on the Lite sets"
    }
  },
  "options": {
    "temperature": {
      "summary": "Sampling randomness: Inspect's --temperature. Provider default sends none, as GSMA's leaderboard runs do; enter a non-negative decimal to set one. Accepted values depend on the model.",
      "default": "default",
      "setups": [
        "original"
      ],
      "pattern": "default|(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?",
      "example": "0.5"
    },
    "subject": {
      "summary": "TeleQnA's question category: every one, or one alone (the task's subject argument).",
      "datasets": [
        "teleqna-lite",
        "teleqna-full"
      ],
      "values": [
        "all",
        "lexicon",
        "research-overview",
        "research-publications",
        "standards-overview",
        "standards-specifications"
      ],
      "default": "all",
      "about": {
        "all": "Every category. The upstream's default.",
        "lexicon": "Lexicon: 50 Lite, 500 Full.",
        "research-overview": "Research overview: 200 Lite, 2,000 Full.",
        "research-publications": "Research publications: 450 Lite, 4,500 Full.",
        "standards-overview": "Standards overview: 100 Lite, 1,000 Full.",
        "standards-specifications": "Standards specifications: 200 Lite, 2,000 Full."
      },
      "setups": [
        "original",
        "yours"
