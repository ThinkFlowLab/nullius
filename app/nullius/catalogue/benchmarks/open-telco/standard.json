{
  "schema": "nullius.benchmark/v1",
  "key": "open-telco",
  "label": "Open Telco",
  "summary": "Each question is one of GSMA's telecom tests, asked as its Inspect task asks it; the task's own scorer reads the last message.",
  "family": "agent",
  "needs": [
    "agent.task/v1"
  ],
  "upstream": {
    "repository": "https://github.com/gsma-labs/evals",
    "tag": "v1.1.0",
    "tested": "708f1c5498793536824eae9919ae003f13c910ea",
    "tested_date": "2026-03-07",
    "license": "MIT"
  },
  "driver": {
    "command": [
      "{install}/.venv/bin/python",
      "{here}/driver.py"
    ],
    "install": {
      "python": "3.12",
      "project": ".",
      "locked": true,
      "pip": [
        "openai==2.26.0"
      ]
    }
  },
  "datasets": [
    {
      "id": "teleqna-lite",
      "label": "TeleQnA · Lite",
      "units": 1000
    },
    {
      "id": "teleqna-full",
      "label": "TeleQnA · Full",
      "units": 10000
    },
    {
      "id": "teletables-lite",
      "label": "TeleTables · Lite",
