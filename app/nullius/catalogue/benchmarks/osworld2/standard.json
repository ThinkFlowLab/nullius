{
  "schema": "nullius.benchmark/v1",
  "key": "osworld2",
  "label": "OSWorld2",
  "summary": "Long multi-app tasks on an Ubuntu desktop VM, scored 0 to 1 by each task's own check.",
  "family": "agent",
  "gated": true,
  "needs": [
    "agent.computer/v1"
  ],
  "upstream": {
    "repository": "https://github.com/xlang-ai/OSWorld-V2",
    "tag": "osworld-v2.1",
    "tested": "3d778a3c9a34a079316f70df023b166700445792",
    "tested_date": "2026-09-16",
    "license": "Apache-2.0"
  },
  "driver": {
    "command": [
      "{install}/.venv/bin/python",
      "{here}/driver.py",
      "{here}/agents.json",
      "{here}/nop.py",
      "{here}/startup/sitecustomize.py",
      "{here}/websites.compose.yml",
      "{here}/gitlab.compose.yml"
    ],
    "install": {
      "python": "3.12",
      "project": ".",
      "locked": true
    }
  },
  "datasets": [
    {
      "id": "offline36",
      "label": "Offline, no services",
      "summary": "36 offline tasks that need no service; some install from PyPI in the VM.",
      "units": 36
    },
    {
      "id": "no_services63",
      "label": "No hosted services",
      "summary": "The 63 tasks that need no service hosted for them: Offline, no services and 27 that need the LLM grader, the simulated user or the public internet. No mock website, GitLab or proxy.",
      "units": 63
    },
    {
      "id": "websites35",
      "label": "Mock website tasks",
      "summary": "The 35 tasks that need the mock websites and no GitLab or proxy: OSWorld-web served on this machine, its suffix given as Website host suffix. 2 of them use Overleaf and run one at a time.",
      "units": 35
    },
    {
      "id": "websites98",
      "label": "No GitLab or proxy",
      "summary": "No hosted services and Mock website tasks: the 98 tasks that need no GitLab or proxy.",
      "units": 98
    },
    {
      "id": "test_v2_offline_no_internet",
      "label": "Offline",
      "summary": "The upstream's offline list; some tasks need GitLab, a proxy or the mock websites.",
      "path": "evaluation_examples/test_v2_offline_no_internet.json",
      "sha256": "a14975fe0972530993d634d380ba574ecbd19b730d14716a392efe02faa62257",
      "units": 82
    },
    {
      "id": "test_v2",
      "label": "All tasks",
      "summary": "Every task, the upstream's default list.",
      "path": "evaluation_examples/test_v2.json",
      "sha256": "7f2c0f531d035dd6f5886c492b96739534385f8e5369e4c764295ad52bf6e7f4",
      "units": 108
    }
  ],
  "units": {
    "noun": "task",
    "nouns": "tasks"
  },
  "score": {
    "kind": "score",
    "says": "OSWorld-V2's own scoring: the task class's evaluate() on the VM's final state, as run_single_example writes it to result.txt (0 to 1, partial credit; result.json carries the detail and safety checks); the upstream's score is the mean",
    "judge": {
      "model": "anthropic/claude-sonnet-4.6",
      "says": "the upstream's LLM grader in the evaluate() of 21 tasks, Claude Sonnet 4.6 over Anthropic's Messages API as run_multienv_m3.sh sets it (OSWORLD_EVAL_MODEL_*), whichever agent runs"
    }
  },
  "limits": {
    "score_seconds": 3600,
    "call_seconds": 3300
  },
  "setups": {
    "original": {
      "summary": "OSWorld-V2's own agent, M3 or Muse Spark, as published, on a Docker VM.",
      "models": [
        "MiniMax-M3",
        "muse-spark-1.3"
      ],
      "default": "MiniMax-M3",
      "side_models": [
        "claude-sonnet-4-6"
      ],
      "served_as": {
        "MiniMax-M3": "minimax/minimax-m3",
        "muse-spark-1.3": "meta/muse-spark-1.3",
        "claude-sonnet-4-6": "anthropic/claude-sonnet-4.6"
      },
      "providers": {
        "openrouter": "",
        "custom": ""
      },
      "turn_seconds": 86400,
      "paper": "the OSWorld-V2 paper, Table 3 (Section 3.2), MiniMax M3",
      "comparable": [
        "MiniMax-M3"
      ]
    }
  },
  "options": {
    "agent": {
      "label": "Agent",
      "summary": "Which of OSWorld-V2's own agents runs: each its script as published, with its own prompts, tools and history, asking the model it is published with.",
      "setups": [
        "original"
      ]
    },
    "max_steps": {
      "label": "Steps per task",
      "summary": "The agent's step limit. default: each agent's own, as its wrapper runs it.",
      "setups": [
        "original"
      ],
      "default": "default",
      "pattern": "default|[1-9][0-9]{0,3}",
      "example": "500",
      "limit": true,
      "by": {
        "agent": {
          "m3": "100",
          "muse_spark": "500"
        }
      }
    },
    "thinking": {
      "label": "Thinking",
      "summary": "Whether M3 thinks. The paper ran it adaptive.",
      "values": [
        "off",
        "adaptive"
      ],
      "default": "off",
      "setups": [
        "original"
      ],
      "about": {
        "off": "upstream default",
        "adaptive": "as in the paper"
      },
      "when": {
        "agent": [
          "m3"
        ]
      }
    },
    "vm_provider": {
      "label": "VM provider",
      "step": "where",
      "summary": "Where the VMs run.",
      "values": [
        "docker"
      ],
      "default": "docker",
      "setups": [
        "original",
        "yours"
      ],
      "needs": {
        "docker": {
          "host": [
            "docker",
            "scoring_programs"
          ],
          "vm": {
            "memory_gb": 4
          }
        }
      }
    },
    "websites": {
      "label": "Website host suffix",
      "step": "dataset",
      "datasets": [
        "websites35",
        "websites98",
        "test_v2_offline_no_internet",
        "test_v2"
      ],
      "summary": "Where the mock websites, and GitLab with them, are served. Needed by the tasks that use them.",
      "pattern": "none|(?=.{3,200}$)[a-z0-9](?:[a-z0-9\\-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9\\-]{0,61}[a-z0-9])?)+",
      "example": "10.213.0.1.nip.io",
      "default": "none",
      "setups": [
        "original",
        "yours"
      ]
    },
    "write_mbps": {
      "label": "Disk write MB/s",
      "summary": "Disk write limit for each VM.",
      "pattern": "none|[1-9][0-9]{0,5}",
      "example": "16",
      "default": "none",
      "setups": [
        "original",
        "yours"
      ]
    },
    "write_iops": {
      "label": "Disk write IOPS",
      "summary": "Disk write limit for each VM.",
      "pattern": "none|[1-9][0-9]{0,5}",
      "example": "160",
      "default": "none",
      "setups": [
        "original",
        "yours"
      ]
    }
  },
  "host": {
    "docker": {
      "label": "Docker",
      "summary": "Docker without sudo; KVM recommended.",
      "check": [
        "docker"
      ]
    },
    "scoring_programs": {
      "label": "Scoring tools",
      "summary": "ImageMagick · FFmpeg · Tesseract",
      "check": [
        "identify",
        "convert",
        "ffmpeg",
        "ffprobe",
        "tesseract"
      ],
      "install": {
        "apt": [
          "imagemagick",
          "ffmpeg",
          "tesseract-ocr"
        ]
      }
    }
  },
  "controls": {
    "nop": {
      "source": "nullius",
      "from": "An agent that does nothing; the untouched VM is scored.",
      "expect": {
        "at_most": 0.01
      }
    }
  },
  "proven": {
    "offline36": {
      "units": {
        "units": 36,
        "passed": "36 ids, the same twice, unique",
        "on": "2026-11-04"
      },
      "nop": {
        "passed": "0/4",
        "value": 0.0,
        "expect": {
          "at_most": 0.0
        },
        "units": 4,
        "job": "2026-11-04__23-15-30__osworld2__offline36__prove-nop",
        "source": "nullius",
        "on": "2026-11-04",
        "limit": 4
      }
    },
    "test_v2": {
      "units": {
        "units": 108,
        "passed": "108 ids, the same twice, unique",
        "on": "2026-11-15"
      },
      "nop": {
        "passed": "0/108",
        "value": 0.0021,
        "expect": {
          "at_most": 0.01
        },
        "units": 108,
        "job": "2026-11-15__06-18-44__osworld2__test_v2__prove-nop",
        "source": "nullius",
        "options": [
          {
            "vm_provider": "docker",
            "websites": "10.213.0.1.nip.io",
            "gitlab": "gitlab.10.213.0.1.nip.io",
            "gitlab_write": "16:160",
            "write_mbps": "16",
            "write_iops": "160"
          },
          {
            "vm_provider": "docker",
            "websites": "10.213.0.1.nip.io",
            "gitlab": "none",
            "gitlab_write": "none",
            "write_mbps": "16",
            "write_iops": "160"
          },
          {
            "vm_provider": "docker",
            "websites": "10.213.0.1.nip.io",
            "gitlab": "none",
            "gitlab_write": "none",
            "write_mbps": "24",
            "write_iops": "240"
          }
        ],
        "judge": "anthropic/claude-sonnet-4.6",
        "on": "2026-11-15"
      }
    }
  }
}
