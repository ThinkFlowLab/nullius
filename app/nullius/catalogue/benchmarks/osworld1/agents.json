          "--coordinate_type",
          "qwen25",
          "--max_tokens",
          "10240",
          "--resize_factor",
          "28",
          "--prompt_style",
          "S1"
        ]
      },
      "env": {
        "OPENAI_BASE_URL": "{base_url}",
        "OPENAI_API_KEY": "{key}"
      }
    },
    "autoglm": {
      "script": "scripts/python/run_autoglm.py",
      "models": [
        "autoglm-os"
      ],
      "drop": [
        "--num_envs",
        "--headless"
      ],
      "argv": [
        "--model",
        "{model}"
      ],
      "env": {
        "OPENAI_BASE_URL": "{base_url}",
        "OPENAI_API_KEY": "{key}"
      }
    },
    "autoglm_v": {
      "script": "scripts/python/run_autoglm_v.py",
      "models": [
        "autoglm-os"
      ],
      "drop": [
        "--num_envs",
        "--headless",
        "--test_config_base_dir"
      ],
      "argv": [
        "--test_config_base_dir",
        "{examples}/examples",
        "--model",
