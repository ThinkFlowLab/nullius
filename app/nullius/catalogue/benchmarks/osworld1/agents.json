      ],
      "env": {
        "OPENAI_BASE_URL": "{base_url}",
        "OPENAI_API_KEY": "{key}"
      }
    },
    "mano": {
      "script": "scripts/python/run_multienv_mano.py",
      "models": [
        "mano"
      ],
      "argv": [
        "--model",
        "{model}"
      ],
      "env": {
