        "passed": "165/165",
        "in_prompt": {
          "units": 1,
          "why": "A question that asks for one of the choices it lists names its answer among those choices."
        },
        "note": "120 reference(s) under 12 characters not looked for: too short to tell a leak from chance; 1 prompt(s) name their answer, as the benchmark says they may: A question that asks for one of the choices it lists names its answer among those choices.",
        "on": "2026-11-11"
      },
      "nop": {
        "passed": "0/165",
        "value": 0.0,
        "expect": {
          "at_most": 0.0
        },
        "units": 165,
        "job": "2026-11-11__23-16-20__gaia__gaia-validation__prove-nop",
