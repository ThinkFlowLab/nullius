{
  "schema": "nullius.benchmark/v1",
  "key": "gaia",
  "label": "GAIA",
  "summary": "Answer real-world questions with optional attachments; the authors\u2019 scorer checks the final answer.",
  "family": "agent",
  "needs": [
    "agent.task/v1",
    "agent.workspace/v1",
    "agent.search/v1"
  ],
  "upstream": {
    "repository": "https://huggingface.co/spaces/gaia-benchmark/leaderboard",
    "tested": "9f133d71362e77b3539f1514f31b9c101a545fec",
    "license": "Apache-2.0",
    "tested_date": "2026-11-06"
  },
  "driver": {
    "command": [
      "{install}/.venv/bin/python",
      "{here}/driver.py"
    ],
    "install": {
      "python": "3.12",
      "pip": [
        "numpy==2.5.4",
        "datasets==5.1.0",
        "huggingface-hub==2.4.0"
      ]
    }
  },
  "datasets": [
    {
      "id": "gaia-validation",
      "label": "Validation \u00b7 All levels",
      "units": 165,
      "environment": "data"
    },
    {
      "id": "gaia-validation-level1",
      "label": "Validation \u00b7 Level 1",
      "units": 53,
      "environment": "data"
    },
    {
      "id": "gaia-validation-level2",
      "label": "Validation \u00b7 Level 2",
      "units": 86,
      "environment": "data"
    },
    {
      "id": "gaia-validation-level3",
      "label": "Validation \u00b7 Level 3",
      "units": 26,
      "environment": "data"
    }
  ],
  "units": {
    "noun": "question",
    "nouns": "questions",
    "redistribute": false
  },
  "environments": {
    "data": {
      "summary": "Access to the gated GAIA dataset.",
      "dockerfile": "env/data.Dockerfile",
      "local_ok": true,
      "needs_secrets": [
        {
          "name": "HF_TOKEN",
          "to": "driver",
          "provider": "huggingface",
          "summary": "Hugging Face access token."
        }
      ],
      "network": {
        "access": "public",
        "probe": "https://en.wikipedia.org/"
      }
    }
  },
  "controls": {
    "nop": {
      "source": "nullius",
      "from": "No agent runs and the answer is empty."
    },
    "oracle": {
      "source": "adapter",
      "from": "The official validation Final answer field, prefixed with FINAL ANSWER:. The raw reference is also written only by the oracle so the leak check can inspect it.",
      "in_prompt": "A question that asks for one of the choices it lists names its answer among those choices."
    }
  },
  "score": {
    "kind": "pass",
    "says": "The authors' scorer, unchanged, compares the text after the last FINAL ANSWER: marker, or the whole reply without one, with the reference."
  },
  "setups": {
    "original": {
      "summary": "The paper's no-tools API procedure: its formatting prompt as the system message, the question as the user message, one call, the authors' scorer unchanged. Attachments are not read.",
      "providers": {
        "openai": "",
        "openrouter": "",
        "custom": ""
      },
      "paper": "GAIA, section 4: direct GPT-4 and GPT-4 Turbo evaluation without plugins; API runs repeated three times.",
      "comparable": false
    }
  },
  "options": {
    "temperature": {
      "label": "Temperature",
      "summary": "Provider default sends none; a non-negative decimal sets it. The paper does not state it.",
      "pattern": "default|(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?",
      "default": "default",
      "setups": [
        "original"
      ]
    }
  },
  "proven": {
    "gaia-validation": {
      "units": {
        "units": 165,
        "passed": "165 ids, the same twice, unique",
        "on": "2026-11-11"
      },
